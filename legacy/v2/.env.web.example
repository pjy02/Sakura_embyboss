SAKURA_WEB_SESSION_SECRET=replace-with-an-independent-random-secret-at-least-32-bytes
# 生产环境必须单独生成；保存凭据后不得更换，也不能与 Web 会话密钥相同。
SAKURA_CREDENTIAL_MASTER_KEY=replace-with-another-random-secret-at-least-32-bytes
# 可选：首次启动时创建本地 Owner 登录身份，成功登录后删除这两行
# SAKURA_BOOTSTRAP_ADMIN_USERNAME=sakura-owner
# SAKURA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
WEB_ADMIN_PATH=sakura-console-k7fd92
WEB_USER_PATH=app
SAKURA_PUBLIC_BASE_URL=https://emby.example.com
SAKURA_COOKIE_SECURE=true
SAKURA_TRUSTED_HOSTS=emby.example.com
SAKURA_CORS_ORIGINS=https://emby.example.com
SAKURA_SESSION_TTL_HOURS=168
SAKURA_LOGIN_TTL_SECONDS=300
SAKURA_DOCS_ENABLED=false
# 独立 Worker 由 docker-compose.yml 自动启动，Bot 内嵌 Worker 固定关闭
SAKURA_TASK_POLL_SECONDS=1
SAKURA_TASK_LEASE_SECONDS=45
SAKURA_TASK_HEARTBEAT_SECONDS=12
SAKURA_DIAGNOSTIC_INTERVAL_SECONDS=60
SAKURA_PROBE_RETENTION_DAYS=30
# 留空时自动告警给 config.json 中的 owner 和 admins；多个 ID 用英文逗号分隔
# SAKURA_ALERT_TELEGRAM_IDS=1029558707,123456789
SAKURA_OPERATIONS_SYNC_SECONDS=30
SAKURA_EVENT_POLL_SECONDS=1
SAKURA_LEGACY_API_ENABLED=false
# SAKURA_LEGACY_API_TOKEN=replace-with-an-independent-webhook-token
