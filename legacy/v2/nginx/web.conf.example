upstream sakura_web {
    server 127.0.0.1:8838;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name sakura.example.com;

    # Replace these paths with your certificate files.
    ssl_certificate     /etc/letsencrypt/live/sakura.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sakura.example.com/privkey.pem;

    location = /api/v1/events/stream {
        proxy_pass http://sakura_web;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/v1/admin/events/stream {
        proxy_pass http://sakura_web;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://sakura_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
