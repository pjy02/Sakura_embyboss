SAKURA_V3_IMAGE=sakura-v3:local
SAKURA_V3_ENVIRONMENT=production
SAKURA_V3_LOG_LEVEL=info
SAKURA_V3_API_BIND_IP=127.0.0.1
SAKURA_V3_API_BIND_PORT=8080

POSTGRES_DB=sakura
POSTGRES_USER=sakura
# Use a URL-safe value because Compose places it in a PostgreSQL URL.
# Example generator: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-postgres-password

SAKURA_V3_REDIS_PASSWORD=replace-with-a-different-long-random-redis-password
SAKURA_V3_REDIS_DATABASE=0
SAKURA_V3_SHUTDOWN_TIMEOUT=15s
SAKURA_V3_DEPENDENCY_TIMEOUT=3s
