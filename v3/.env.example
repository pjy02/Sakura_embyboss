SAKURA_V3_IMAGE=233bit/sakura_embyboss:latest
SAKURA_V3_ENVIRONMENT=production
SAKURA_V3_LOG_LEVEL=info
SAKURA_V3_API_BIND_IP=127.0.0.1
SAKURA_V3_API_BIND_PORT=8080
SAKURA_V3_WEB_IMAGE=233bit/sakura_embyboss:web-latest
SAKURA_V3_WEB_BIND_IP=127.0.0.1
SAKURA_V3_WEB_BIND_PORT=8088
SAKURA_V3_SHARED_NETWORK=sakura-v3-shared

POSTGRES_DB=sakura
POSTGRES_USER=sakura
# Use a URL-safe value because Compose places it in a PostgreSQL URL.
# Example generator: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-postgres-password

SAKURA_V3_REDIS_PASSWORD=replace-with-a-different-long-random-redis-password
SAKURA_V3_REDIS_DATABASE=0
SAKURA_V3_SHUTDOWN_TIMEOUT=15s
SAKURA_V3_DEPENDENCY_TIMEOUT=3s
SAKURA_V3_WORKER_POLL_INTERVAL=1s
SAKURA_V3_WORKER_LEASE_DURATION=90s

# Generate with: openssl rand -hex 32
SAKURA_V3_CREDENTIAL_MASTER_KEY=replace-with-exactly-64-hex-characters-generated-by-openssl
# Generate independently with: openssl rand -hex 32
SAKURA_V3_INTERNAL_BOT_TOKEN=replace-with-an-independent-random-token-at-least-32-characters

SAKURA_V3_SESSION_TTL=168h
SAKURA_V3_SESSION_COOKIE=sakura_v3_session
# Set false only for direct local HTTP development. Production HTTPS must use true.
SAKURA_V3_COOKIE_SECURE=true

# Optional one-time owner bootstrap. Remove both values after the first start.
# SAKURA_V3_BOOTSTRAP_ADMIN_USERNAME=sakura-owner
# SAKURA_V3_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Preferred: leave this empty and create credential `telegram.bot_token` in
# the credential center. This environment fallback is useful for first setup.
SAKURA_V3_TELEGRAM_BOT_TOKEN=
SAKURA_V3_TELEGRAM_API_BASE=https://api.telegram.org

# Phase 8 migration tools. Use a MySQL account that becomes read-only once the
# final backup begins. URL-escape special characters in the password.
# SAKURA_V2_DATABASE_DSN=sakura:password@tcp(v2-mysql:3306)/sakura?parseTime=true&loc=UTC
# SAKURA_V2_CREDENTIAL_MASTER_KEY=the-exact-v2-credential-master-key
