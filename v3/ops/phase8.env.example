# Copy to a root-readable file outside the repository, fill every required
# value, then source it before a rehearsal or cutover.
V2_COMPOSE_DIR=/docker/sakura_embyboss
V2_COMPOSE_FILE=/docker/sakura_embyboss/docker-compose.yml
V2_ENV_FILE=/docker/sakura_embyboss/.env
V2_CONFIG_PATH=/docker/sakura_embyboss/config.json
V2_MYSQL_SERVICE=mysql
V2_WRITER_SERVICES="bot web"
V2_PROXY_PORT=8838

V3_ENV_PATH=/docker/sakura-v3/.env
V3_COMPOSE_DIR=/docker/sakura-v3
SAKURA_V3_ENV_FILE=/docker/sakura-v3/.env
SAKURA_V3_SHARED_NETWORK=sakura-v3-shared
# Prefer values copied from the workflow deployment artifact: repository@sha256:digest
SAKURA_V3_IMAGE=233bit/sakura_embyboss@sha256:replace-app-digest
SAKURA_V3_WEB_IMAGE=233bit/sakura_embyboss@sha256:replace-web-digest
SAKURA_RELEASE_COMMIT=replace-github-commit

# This DSN must be reachable from the v3 shared Docker network. During a final
# cutover, stop all v2 writers before running the importer.
SAKURA_V2_DATABASE_DSN=sakura:password@tcp(v2-mysql:3306)/sakura?parseTime=true&loc=UTC
# The exact v2 SAKURA_CREDENTIAL_MASTER_KEY, or its session-secret fallback.
SAKURA_V2_CREDENTIAL_MASTER_KEY=replace-with-v2-master-key
SAKURA_V3_DATABASE_URL=postgres://sakura:password@postgres:5432/sakura?sslmode=disable

SAKURA_BLUE_API_PORT=18080
SAKURA_BLUE_WEB_PORT=18088
SAKURA_GREEN_API_PORT=28080
SAKURA_GREEN_WEB_PORT=28088
SAKURA_MAINTENANCE_PORT=18090

# The reverse-proxy site must include this file before its proxy_pass line:
#   include /opt/sakura/runtime/upstream-target.conf;
#   proxy_pass $sakura_upstream;
SAKURA_PROXY_TARGET_FILE=/opt/sakura/runtime/upstream-target.conf
# 1Panel example; replace the container name with the current one.
SAKURA_PROXY_TEST_COMMAND="docker exec 1Panel-openresty-example openresty -t"
SAKURA_PROXY_RELOAD_COMMAND="docker exec 1Panel-openresty-example openresty -s reload"

SAKURA_BACKUP_DIR=/backup/sakura
# Public age recipient only. Keep the corresponding identity off the server.
AGE_RECIPIENT=age1replace-with-offline-backup-recipient
# Required for execute mode: site-specific TMDB/MoviePilot and Telegram getMe checks.
TELEGRAM_TOKEN_FILE=/root/sakura-secrets/telegram-token
TMDB_TOKEN_FILE=/root/sakura-secrets/tmdb-token
MOVIEPILOT_TOKEN_FILE=/root/sakura-secrets/moviepilot-token
MOVIEPILOT_HEALTH_URL=http://moviepilot:3000/api/v1/system/health
SAKURA_EXTERNAL_SMOKE_COMMAND="bash /docker/sakura-v3/ops/external-smoke.example.sh"
SAKURA_EMBY_RECONCILE_TIMEOUT_SECONDS=600
