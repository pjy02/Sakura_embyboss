# Published image. Use a fixed version tag in production for easy rollback.
SAKURA_IMAGE=your-dockerhub-user/sakura_embyboss:latest
TZ=Asia/Shanghai

# MySQL credentials. Replace every placeholder before deployment.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=embyboss
MYSQL_USER=sakura
MYSQL_PASSWORD=replace-with-a-long-random-app-password

# Web public address and cookie/session security.
SAKURA_WEB_SESSION_SECRET=replace-with-at-least-32-random-bytes
SAKURA_PUBLIC_BASE_URL=https://emby.example.com
SAKURA_COOKIE_SECURE=true
SAKURA_TRUSTED_HOSTS=emby.example.com
SAKURA_CORS_ORIGINS=https://emby.example.com

# The management path should be hard to guess and must not be "admin".
WEB_ADMIN_PATH=sakura-console-k7fd92
WEB_USER_PATH=app

# Only expose the Web service on loopback; terminate HTTPS at Caddy/Nginx.
SAKURA_WEB_BIND_IP=127.0.0.1
SAKURA_WEB_BIND_PORT=8838
# Safe with loopback binding: trust the local reverse proxy's forwarded headers.
SAKURA_FORWARDED_ALLOW_IPS=*

# Background task reliability controls.
SAKURA_TASK_WORKER_ENABLED=1
SAKURA_TASK_POLL_SECONDS=1
SAKURA_TASK_LEASE_SECONDS=45
SAKURA_TASK_HEARTBEAT_SECONDS=12
# External service probes and risk alert delivery.
SAKURA_DIAGNOSTIC_INTERVAL_SECONDS=60
SAKURA_PROBE_RETENTION_DAYS=30
# Optional; defaults to config.json owner and admins. Separate IDs with commas.
# SAKURA_ALERT_TELEGRAM_IDS=1029558707,123456789
# Refresh live playback, playback history and device profiles from Emby.
SAKURA_OPERATIONS_SYNC_SECONDS=30
# Database outbox polling interval used by Web realtime synchronization.
SAKURA_EVENT_POLL_SECONDS=1

# Keep compatibility endpoints and API docs disabled in production.
SAKURA_DOCS_ENABLED=false
SAKURA_LEGACY_API_ENABLED=false
# SAKURA_LEGACY_API_TOKEN=replace-with-an-independent-random-token
